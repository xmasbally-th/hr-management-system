# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code worktree artifacts (session, plans, design assets)
.claude/

# Agent skills (re-install via: npx skills add supabase/agent-skills)
.agents/

# Local-only DB introspection tool (uses SUPABASE_DB_URL)
scripts/db.mjs

# generated .docx output from leave/template test scripts
scripts/out/
